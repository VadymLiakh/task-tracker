#!/bin/sh
# pre-commit: перевіряє стиль Python-файлів, доданих до коміту, лінтером flake8.
# Якщо flake8 знаходить помилки, коміт скасовується.

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -z "$files" ]; then
    exit 0
fi

echo "pre-commit: перевірка стилю (flake8)..."
if ! python -m flake8 $files; then
    echo
    echo "pre-commit: знайдено помилки стилю, коміт скасовано."
    echo "Виправте зауваження flake8 і повторіть коміт."
    exit 1
fi
echo "pre-commit: помилок не знайдено."
exit 0
